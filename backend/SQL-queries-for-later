
# Errechne rundenresultate

SELECT m.id, p.id, play_points, RANK() OVER (PARTITION BY m.id ORDER BY play_points DESC) AS Rank
FROM round_results rr1
JOIN rounds r1 ON r1.id = rr1.round_id
JOIN matches m ON r1.match_id = m.id
JOIN vorrunden v ON m.vorrunde_id = v.id
JOIN tables t ON m.table_id = t.id
JOIN players p ON rr1.player_id = p.id
WHERE r1.round_number >= all(
	SELECT r2.round_number 
	FROM rounds r2
	WHERE r1.match_id = r2.match_id);

# Errechne Turniertabelle

WITH R as(
            SELECT RANK() OVER (ORDER BY sum(tournament_points) DESC, 
            							sum(mr.total_play_points) DESC)
            							AS standing, 
            		username, 
            		sum(tournament_points) TP, 
            		sum(mr.total_play_points) PP,
            		status
            FROM match_results mr
            JOIN matches m ON mr.match_id = m.id
            JOIN players p ON mr.player_id = p.id
            GROUP BY p.id, username)

            SELECT r1.standing, r1.username, r1.tp, r1.pp,
            	CASE 
            		WHEN status = 'hat_bereits_qualifikation' THEN 'hat_bereits_qualifikation' 
            		WHEN status = 'disqualifiziert' THEN 'disqualifiziert'
            		WHEN r1.standing <= 4 + (select count(*) from R r2 where r2.standing < r1.standing and r2.status <> 'none') THEN 'qualifiziert'
            		ELSE 'none'
            	END as status2
            FROM R r1



